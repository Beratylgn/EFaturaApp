@model IEnumerable<EFaturaApp.Models.Invoice>
@{
    ViewData["Title"] = "Fatura Listesi";
    Func<string, string> sym = (cur) => cur == "USD" ? "$" : (cur == "EUR" ? "€" : "₺");
}

<h2>Fatura Listesi</h2>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">Yeni Fatura</a>
</div>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Fatura No</th>
            <th>Tarih</th>
            <th>Müşteri</th>
            <th class="text-end">Toplam Tutar</th>
            <th class="text-end">İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var inv in Model)
        {
            <tr>
                <td>@inv.InvoiceNo</td>
                <td>@inv.InvoiceDate?.ToString("dd.MM.yyyy")</td>
                <td>@inv.ReceiverCustomer?.CompanyName</td>
                <td class="text-end">@inv.TotalAmount?.ToString("N2")</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@inv.Id" class="btn btn-info btn-sm">Detay</a>
                    <a asp-action="Edit" asp-route-id="@inv.Id" class="btn btn-warning btn-sm">Düzenle</a>
                    <a asp-action="Delete" asp-route-id="@inv.Id" class="btn btn-danger btn-sm">Sil</a>
                    <a asp-action="ExportPdf" asp-route-id="@inv.Id" class="btn btn-secondary btn-sm">PDF</a>
                    <a asp-action="ExportExcel" asp-route-id="@inv.Id" class="btn btn-success btn-sm">Excel</a>
                </td>
            </tr>
        }

    </tbody>
</table>
